#!/bin/sh
# webosbrew boot hook, first in run-parts order. Two jobs, both as early as hooks can run (about 38 to 44 s after boot):
# 1. Stop LG's preload manager and close the apps it had already preloaded (LG Channels, Google Assistant, YouTube). Luma, opened by the TV as an input at about 23 s,
#    was exiting by itself at about 48 s while those preloads took the memory; the TV then relaunched it and the screen went black for a few seconds.
# 2. LG's update process learns of a firmware update in the first seconds of every boot and pops up its alert at about 37 s. Restarting that process wipes the record.
#    Checked every 0.5 s from the first moment, then every 10 minutes. Log: /tmp/clear-update-banner.log.
# Never blocks boot. Undo: rm /var/lib/webosbrew/init.d/00-clear-update.
(
  PATH="/bin:/sbin:/usr/bin:/usr/sbin:$PATH"
  LOG=/tmp/clear-update-banner.log
  up() { cut -d. -f1 /proc/uptime; }
  systemctl stop preload-manager.service 2>/dev/null
  front=$(luna-send -n 1 luna://com.webos.applicationManager/getForegroundAppInfo '{}' </dev/null 2>/dev/null | sed -n 's/.*"appId": *"\([^"]*\)".*/\1/p')
  for a in lgchannels com.webos.app.lgchannels google.assistant youtube.leanback.v4 netflix amazon; do
    [ "$a" = "$front" ] && continue
    luna-send -n 1 luna://com.webos.applicationManager/closeByAppId "{\"id\":\"$a\"}" </dev/null >/dev/null 2>&1
  done
  echo "boot+$(up)s preload manager stopped, preloaded apps closed (front=$front)" >> $LOG
  clear() {
    n=$(luna-send -n 1 luna://com.webos.service.update/getStatus '{}' </dev/null 2>/dev/null | sed -n 's/.*"nsuImageSize": *\([0-9]*\).*/\1/p')
    [ -n "$n" ] && [ "$n" -gt 0 ] || return
    for p in /proc/[0-9]*; do
      [ "$(cat $p/comm 2>/dev/null)" = update ] || continue
      kill "${p#/proc/}" 2>/dev/null && echo "boot+$(up)s update record ($n bytes) cleared, update process ${p#/proc/} restarted" >> $LOG
    done
  }
  i=0
  while :; do
    clear
    if [ $i -lt 360 ]; then i=$((i + 1)); sleep 0.5; else sleep 600; fi
  done
) </dev/null >/dev/null 2>&1 &
exit 0
